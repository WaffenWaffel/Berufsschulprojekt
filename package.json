{
  "scripts": {
    "dev:client": "cd Client && npm run dev",
    "dev:server": "npm run dev --prefix server",
    "dev": "concurrently \"npm run dev:client\" \"npm run dev:server\"",
    "build": "cd Client && npm install && npm run build",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "concurrently": "^9.2.1"
  },
  "dependencies": {
    "csv-parser": "^3.2.0"
  }
}
